{
  "name": "unilink",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config",
    "start:preview": "vp preview",
    "cf:types": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio --config drizzle.studio.config.ts",
    "db:pull:staging": "node scripts/pull-staging.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --env staging --remote",
    "db:migrate:prod": "wrangler d1 migrations apply DB --env production --remote",
    "deploy:staging": "CLOUDFLARE_ENV=staging vp build && wrangler deploy",
    "deploy:prod": "CLOUDFLARE_ENV=production vp build && wrangler deploy",
    "seed": "node --import ./scripts/ts-resolve.mjs scripts/seed.ts",
    "area-points": "node scripts/area-points.ts",
    "faculty:sql": "node scripts/faculty-sql.ts",
    "seed:rides": "node scripts/seed-rides.ts",
    "seed:admin": "node scripts/seed-admin.ts --local",
    "seed:admin:staging": "node scripts/seed-admin.ts --staging",
    "seed:admin:prod": "node scripts/seed-admin.ts --prod",
    "push:keys": "node scripts/generate-vapid.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@block65/webcrypto-web-push": "2.0.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/noto-sans-bengali": "^5.3.0",
    "@hono/zod-validator": "0.9.1",
    "@hookform/resolvers": "5.9.2",
    "@tailwindcss/vite": "4.3.4",
    "@tanstack/history": "1.162.5",
    "@tanstack/react-query": "5.105.3",
    "@tanstack/react-router": "1.170.46",
    "@xyflow/react": "^12.12.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "lucide-react": "1.67.0",
    "maplibre-gl": "^6.17.0",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "shadcn": "4.23.0",
    "sonner": "2.0.8",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/vitest-plugin": "1.5.0",
    "@libsql/client": "^0.18.0",
    "@tanstack/router-plugin": "1.168.48",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/browser-playwright": "5.0.5",
    "drizzle-kit": "0.31.11",
    "happy-dom": "21.0.4",
    "playwright": "^1.64.1",
    "typescript": "6.0.3",
    "vite": "catalog:",
    "vite-plugin-pwa": "2.0.0",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "workbox-window": "7.4.1",
    "wrangler": "4.156.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "24.22.0"
  }
}
