{
  "name": "unilink",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config",
    "start:preview": "vp preview",
    "cf:types": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --env staging --remote",
    "db:migrate:prod": "wrangler d1 migrations apply DB --env production --remote",
    "deploy:staging": "CLOUDFLARE_ENV=staging vp build && wrangler deploy",
    "deploy:prod": "CLOUDFLARE_ENV=production vp build && wrangler deploy",
    "seed": "node scripts/seed.ts",
    "faculty:sql": "node scripts/faculty-sql.ts",
    "seed:admin": "node scripts/seed-admin.ts --local",
    "seed:admin:staging": "node scripts/seed-admin.ts --staging",
    "seed:admin:prod": "node scripts/seed-admin.ts --prod",
    "push:keys": "node scripts/generate-vapid.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@block65/webcrypto-web-push": "2.0.0",
