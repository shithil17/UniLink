{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unilink",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Every non-/api path is served from the built PWA; unknown paths fall back to index.html.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // Top level = local dev and tests. Bindings are not inherited by envs, so each env repeats them.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unilink-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle",
    },
  ],
  "ai": { "binding": "AI" },
  // Where a banned user is told to reach the admins (shown at login). Empty means no address is shown.
  // Set the real address per environment in this file (a deploy overwrites dashboard-set vars, and the
  // address is public, so it is not a secret). Vars are not inherited by envs, so each repeats it.
  "vars": { "ADMIN_CONTACT_EMAIL": "" },
  // Daily at 21:00 UTC (03:00 Asia/Dhaka): cleanup jobs in src/server/cron.ts. Triggers are not inherited by envs.
  "triggers": { "crons": ["0 21 * * *"] },
  "env": {
    "staging": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "unilink-staging",
          "database_id": "1ecb692c-cee5-42ca-9212-fa97ba6c5c38",
          "migrations_dir": "drizzle",
        },
      ],
      "ai": { "binding": "AI" },
      "vars": { "ADMIN_CONTACT_EMAIL": "" },
      "triggers": { "crons": ["0 21 * * *"] },
    },
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "unilink-prod",
          "database_id": "4bd5738d-8a1b-4664-84b5-6b6aeb481758",
          "migrations_dir": "drizzle",
        },
      ],
      "ai": { "binding": "AI" },
      "vars": { "ADMIN_CONTACT_EMAIL": "" },
      "triggers": { "crons": ["0 21 * * *"] },
    },
  },
}
